{
  "name": "luci-theme-fluent",
  "version": "1.0.0",
  "type": "module",
  "description": "FluentUI theme for OpenWrt LuCI",
  "scripts": {
    "build": "sass --no-source-map scss/fluent.scss htdocs/luci-static/fluent/css/fluent.css",
    "build:min": "sass scss/fluent.scss htdocs/luci-static/fluent/css/fluent.min.css --style=compressed",
    "watch": "sass --no-source-map --watch scss/fluent.scss htdocs/luci-static/fluent/css/fluent.css",
    "lint": "sass-lint -v",
    "test": "echo \"No tests yet\" && exit 0",
    "deploy": "luci-types dev",
    "dev:remote": "luci-types dev"
  },
  "devDependencies": {
    "@types/node": "^22.19.19",
    "sass": "^1.100.0",
    "sass-lint": "^1.13.1",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@10.12.4",
  "dependencies": {
    "@lazulikao/luci-types": "github:LazuliKao/luci-types"
  }
}